{
  "source_id": 1,
  "source_name": "Source 1",
  "web": {
    "bind": "0.0.0.0",
    "port": 8084
  },
  "storage": {
    "logs_dir": "./logs"
  },
  "nmea": {
    "type": "tcp",
    "usb_device": "/dev/ttyUSB0",
    "usb_baud": 115200,
    "uart_device": "/dev/serial0",
    "uart_baud": 115200,
    "tcp_bind": "0.0.0.0",
    "tcp_port": 10110
  },
  "siren_trigger": {
    "mode": "auto",
    "gpio_bcm": 17,
    "pull": "down",
    "debounce_ms": 10
  },
  "audio": {
    "enabled": false,
    "backend": "auto",
    "alsa_device": "hw:1,0",
    "windows_device": "default",
    "ffmpeg_path": "ffmpeg",
    "sample_rate_hz": 48000,
    "channels": 1,
    "sample_format": "S16_LE",
    "bytes_per_sample": 2,
    "block_frames": 1024
  },
  "s3": {
    "endpoint_url": "",
    "bucket": "",
    "region": "us-east-1",
    "access_key_id": "",
    "prefix": "source-sirena",
    "auto_upload": false
  },
  "localpc": {
    "enabled": false,
    "host": "192.168.8.11",
    "port": 10201,
    "connect_timeout_s": 3.0,
    "retry_window_s": 20.0,
    "retry_interval_s": 2.0
  },
  "ego_sync": {
    "enabled": true,
    "start_with_ego": true,
    "web_port": 80,
    "poll_interval_s": 1.0,
    "timeout_s": 2.0
  }
}
