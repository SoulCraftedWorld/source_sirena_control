[Unit]
Description=Source Sirena test logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
SupplementaryGroups=dialout gpio audio
WorkingDirectory=/home/admin/source_sirena
ExecStart=/home/admin/source_sirena/.venv/bin/python server.py --bind 0.0.0.0 --port 80
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
